# Copy to .env (never commit .env)
# Production: ALL variables below are required (startup fails fast if missing).
# Development: safe local defaults apply where noted.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/chatx
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Phase 9A image uploads (Cloudinary object storage). Server-only secrets.
# Leave empty to disable uploads; everything else keeps working.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Message translation (server-only; NEVER expose these to the frontend).
# Optional: without a key the service uses MyMemory free tier, then the
# offline conversational phrasebook. Chat always keeps working.
# TRANSLATION_PROVIDER: auto|google|mymemory|phrasebook (default: auto)
TRANSLATION_PROVIDER=
GOOGLE_TRANSLATE_API_KEY=
